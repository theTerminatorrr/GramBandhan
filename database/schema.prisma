generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model farmer_profiles {
  farmer_id   BigInt     @id
  land_size   Decimal?   @db.Decimal(10, 2)
  location    String?    @db.VarChar(150)
  crops_grown String?
  rating      Decimal    @default(0.0) @db.Decimal(3, 2)
  users       users      @relation(fields: [farmer_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  projects    projects[]
}

model field_agent_profiles {
  agent_id          BigInt              @id
  assigned_region   String?             @db.VarChar(150)
  users             users               @relation(fields: [agent_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  milestone_updates milestone_updates[]
}

model fraud_alerts {
  alert_id       BigInt        @id @default(autoincrement())
  user_id        BigInt?
  transaction_id BigInt?
  reason         String
  flagged_at     DateTime      @default(now()) @db.Timestamp(6)
  transactions   transactions? @relation(fields: [transaction_id], references: [transaction_id], onDelete: NoAction, onUpdate: NoAction)
  users          users?        @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model insurance_claims {
  claim_id           BigInt             @id @default(autoincrement())
  policy_id          BigInt
  evidence           String?
  status             claim_status       @default(submitted)
  filed_at           DateTime           @default(now()) @db.Timestamp(6)
  insurance_policies insurance_policies @relation(fields: [policy_id], references: [policy_id], onDelete: NoAction, onUpdate: NoAction)
}

model insurance_policies {
  policy_id        BigInt             @id @default(autoincrement())
  project_id       BigInt
  coverage_type    String?            @db.VarChar(100)
  premium          Decimal            @db.Decimal(12, 2)
  status           insurance_status   @default(active)
  started_at       DateTime           @default(now()) @db.Timestamp(6)
  insurance_claims insurance_claims[]
  projects         projects           @relation(fields: [project_id], references: [project_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model investments {
  investment_id     BigInt            @id @default(autoincrement())
  investor_id       BigInt
  project_id        BigInt
  amount            Decimal           @db.Decimal(14, 2)
  expected_return   Decimal?          @db.Decimal(14, 2)
  status            investment_status @default(active)
  invested_at       DateTime          @default(now()) @db.Timestamp(6)
  investor_profiles investor_profiles @relation(fields: [investor_id], references: [investor_id], onDelete: NoAction, onUpdate: NoAction)
  projects          projects          @relation(fields: [project_id], references: [project_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([investor_id], map: "idx_investments_investor")
  @@index([project_id], map: "idx_investments_project")
}

model investor_profiles {
  investor_id    BigInt        @id
  total_invested Decimal       @default(0) @db.Decimal(14, 2)
  wallet_balance Decimal       @default(0) @db.Decimal(14, 2)
  risk_profile   String        @default("moderate") @db.VarChar(30)
  investments    investments[]
  users          users         @relation(fields: [investor_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model milestone_updates {
  update_id            BigInt                @id @default(autoincrement())
  project_id           BigInt
  verified_by          BigInt?
  notes                String?
  photo_urls           String[]
  expense_log          Decimal?              @db.Decimal(14, 2)
  created_at           DateTime              @default(now()) @db.Timestamp(6)
  projects             projects              @relation(fields: [project_id], references: [project_id], onDelete: NoAction, onUpdate: NoAction)
  field_agent_profiles field_agent_profiles? @relation(fields: [verified_by], references: [agent_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([project_id], map: "idx_milestones_project")
}

model notifications {
  notification_id BigInt   @id @default(autoincrement())
  user_id         BigInt
  message         String
  is_read         Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamp(6)
  users           users    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "idx_notifications_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  order_id         BigInt           @id @default(autoincrement())
  buyer_id         BigInt
  listing_id       BigInt
  quantity         Int
  total_price      Decimal          @db.Decimal(12, 2)
  status           order_status     @default(placed)
  ordered_at       DateTime         @default(now()) @db.Timestamp(6)
  users            users            @relation(fields: [buyer_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  product_listings product_listings @relation(fields: [listing_id], references: [listing_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([buyer_id], map: "idx_orders_buyer")
  @@index([listing_id], map: "idx_orders_listing")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model product_listings {
  listing_id    BigInt    @id @default(autoincrement())
  producer_id   BigInt
  name          String    @db.VarChar(150)
  category      String?   @db.VarChar(100)
  price         Decimal   @db.Decimal(12, 2)
  quantity      Int       @default(0)
  description   String?
  delivery_area String?   @db.VarChar(150)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  orders        orders[]
  users         users     @relation(fields: [producer_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  ratings       ratings[]

  @@index([producer_id], map: "idx_listings_producer")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model projects {
  project_id         BigInt               @id @default(autoincrement())
  farmer_id          BigInt
  title              String               @db.VarChar(200)
  description        String
  crop_type          String?              @db.VarChar(100)
  fund_goal          Decimal              @db.Decimal(14, 2)
  fund_raised        Decimal              @default(0) @db.Decimal(14, 2)
  start_date         DateTime?            @db.Date
  end_date           DateTime?            @db.Date
  status             project_status       @default(pending)
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  insurance_policies insurance_policies[]
  investments        investments[]
  milestone_updates  milestone_updates[]
  farmer_profiles    farmer_profiles      @relation(fields: [farmer_id], references: [farmer_id], onDelete: NoAction, onUpdate: NoAction)
  ratings            ratings[]
  risk_scores        risk_scores[]

  @@index([farmer_id], map: "idx_projects_farmer")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ratings {
  rating_id                         BigInt            @id @default(autoincrement())
  from_user_id                      BigInt
  to_user_id                        BigInt?
  project_id                        BigInt?
  listing_id                        BigInt?
  stars                             Int               @db.SmallInt
  comment                           String?
  created_at                        DateTime          @default(now()) @db.Timestamp(6)
  users_ratings_from_user_idTousers users             @relation("ratings_from_user_idTousers", fields: [from_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  product_listings                  product_listings? @relation(fields: [listing_id], references: [listing_id], onDelete: NoAction, onUpdate: NoAction)
  projects                          projects?         @relation(fields: [project_id], references: [project_id], onDelete: NoAction, onUpdate: NoAction)
  users_ratings_to_user_idTousers   users?            @relation("ratings_to_user_idTousers", fields: [to_user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model risk_scores {
  score_id       BigInt     @id @default(autoincrement())
  project_id     BigInt
  score          Decimal    @db.Decimal(5, 2)
  level          risk_level
  factors        String?
  recommendation String?
  generated_at   DateTime   @default(now()) @db.Timestamp(6)
  projects       projects   @relation(fields: [project_id], references: [project_id], onDelete: NoAction, onUpdate: NoAction)
}

model transactions {
  transaction_id BigInt             @id @default(autoincrement())
  user_id        BigInt
  amount         Decimal            @db.Decimal(14, 2)
  type           transaction_type
  method         payment_method?
  status         transaction_status @default(pending)
  reference_id   BigInt?
  created_at     DateTime           @default(now()) @db.Timestamp(6)
  fraud_alerts   fraud_alerts[]
  users          users              @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([user_id], map: "idx_transactions_user")
}

model users {
  user_id                             BigInt                @id @default(autoincrement())
  name                                String                @db.VarChar(150)
  email                               String                @unique @db.VarChar(150)
  phone                               String                @unique @db.VarChar(20)
  password_hash                       String                @db.VarChar(255)
  role                                user_role
  is_verified                         Boolean               @default(false)
  kyc_status                          String                @default("pending") @db.VarChar(30)
  created_at                          DateTime              @default(now()) @db.Timestamp(6)
  farmer_profiles                     farmer_profiles?
  field_agent_profiles                field_agent_profiles?
  fraud_alerts                        fraud_alerts[]
  investor_profiles                   investor_profiles?
  notifications                       notifications[]
  orders                              orders[]
  product_listings                    product_listings[]
  ratings_ratings_from_user_idTousers ratings[]             @relation("ratings_from_user_idTousers")
  ratings_ratings_to_user_idTousers   ratings[]             @relation("ratings_to_user_idTousers")
  transactions                        transactions[]
}

enum claim_status {
  submitted
  under_review
  approved
  rejected
  paid
}

enum insurance_status {
  active
  claimed
  expired
}

enum investment_status {
  active
  completed
  withdrawn
}

enum order_status {
  placed
  confirmed
  delivered
  cancelled
}

enum payment_method {
  bkash
  nagad
  bank_transfer
}

enum project_status {
  pending
  active
  completed
  rejected
}

enum risk_level {
  low
  medium
  high
}

enum transaction_status {
  pending
  completed
  failed
}

enum transaction_type {
  investment
  purchase
  withdrawal
  premium
  claim_payout
}

enum user_role {
  farmer
  investor
  field_agent
  admin
  buyer
}
